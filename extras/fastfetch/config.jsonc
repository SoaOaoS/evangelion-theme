// Evangelion fastfetch: a MAGI status readout.
// Install: cp -r extras/fastfetch/* ~/.config/fastfetch/
// Colours are ANSI names, so they follow whichever Evangelion variant is active.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nerv.txt",
    "color": { "1": "magenta", "2": "green", "3": "yellow" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "title": "yellow" },
    "key": { "width": 16 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#yellow}▌ MAGI SYSTEM ── STATUS REPORT" },
    { "type": "custom", "format": "{#magenta}───────────────────────────────────────" },
    { "type": "title", "key": "PILOT", "format": "{user-name}" },
    { "type": "host", "key": "UNIT" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "CORE" },
    { "type": "uptime", "key": "SYNC TIME" },
    { "type": "packages", "key": "ARMAMENT" },
    { "type": "shell", "key": "ENTRY PLUG" },
    { "type": "wm", "key": "COMMAND" },
    { "type": "terminal", "key": "TERMINAL" },
    { "type": "custom", "format": "{#magenta}───────────────────────────────────────" },
    { "type": "cpu", "key": "S² ENGINE" },
    { "type": "gpu", "key": "MAGI" },
    { "type": "memory", "key": "LCL" },
    { "type": "disk", "key": "TERMINAL DOGMA", "folders": "/" },
    { "type": "battery", "key": "UMBILICAL" },
    { "type": "custom", "format": "{#magenta}───────────────────────────────────────" },
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
